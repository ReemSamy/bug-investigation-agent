{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Hosting": {
    "DatabaseProvider": "Sqlite",
    "DatabaseConnectionString": "",
    "UseManagedIdentityForDatabase": false,
    "ManagedIdentityClientId": "",
    "KeyVaultUri": "",
    "ServiceBusNamespace": "",
    "ServiceBusQueueName": "investigations",
    "BlobServiceUri": "",
    "EvidenceContainer": "evidence",
    "DataProtectionContainer": "dataprotection",
    "DataProtectionKeyId": ""
  },
  "Forge": {
    "AppId": "",
    "EnvironmentId": "",
    "PublicBaseUrl": "",
    "AllowedCloudIds": [],
    "CustomUiOrigins": [
      "https://*.cdn.prod.atlassian-dev.net"
    ]
  },
  "EnvironmentRegistry": {
    "AllowAdHocUrl": true,
    "TreatAdHocAsProduction": false,
    "DefaultLogin": {
      "Mode": "Form",
      "LoginPath": "",
      "UsernameSelectors": [
        "#UserName",
        "input[name='UserName']",
        "input[autocomplete='username']",
        "input[name*=user i]",
        "input[id*=user i]",
        "input[type=email]",
        "input[type=text]"
      ],
      "PasswordSelectors": [
        "#Password",
        "input[name='Password']",
        "input[autocomplete='current-password']",
        "input[type=password]"
      ],
      "SubmitSelectors": [
        "button[type=submit]:visible",
        "input[type=submit]:visible",
        "#btnSubmit",
        "button:has-text('Log in')",
        "button:has-text('Sign in')",
        "button:has-text('Submit')"
      ],
      "SuccessSelectors": [],
      "OutcomeTimeoutMs": 20000
    },
    "Environments": {
      "KMSRC": {
        "DisplayName": "KMSRC",
        "ApplicationId": "KMS",
        "BaseUrl": "",
        "Type": "ReleaseCandidate",
        "Enabled": true,
        "Aliases": [
          "KMS RC",
          "KMS-RC"
        ]
      },
      "KMSQA": {
        "DisplayName": "KMSQA",
        "ApplicationId": "KMS",
        "BaseUrl": "",
        "Type": "QA",
        "Enabled": true,
        "Aliases": [
          "KMS QA",
          "KMS-QA"
        ]
      }
    }
  },
  "Agent": {
    "DataDirectory": "App_Data",
    "EvidenceDirectory": "App_Data/evidence"
  }
}