{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Hosting": {
    "DatabaseProvider": "Sqlite",
    "DatabaseConnectionString": "",
    "UseManagedIdentityForDatabase": false,
    "ManagedIdentityClientId": "",
    "KeyVaultUri": "",
    "ServiceBusNamespace": "",
    "ServiceBusQueueName": "investigations",
    "BlobServiceUri": "",
    "EvidenceContainer": "evidence",
    "DataProtectionContainer": "dataprotection",
    "DataProtectionKeyId": ""
  },
  "Forge": {
    "AppId": "",
    "EnvironmentId": "",
    "PublicBaseUrl": "",
    "AllowedCloudIds": [],
    "CustomUiOrigins": [
      "https://*.cdn.prod.atlassian-dev.net"
    ]
  },
  "EnvironmentRegistry": {
    "AllowAdHocUrl": true,
    "TreatAdHocAsProduction": false,
    "DefaultLogin": {
      "Mode": "Form",
      "LoginPath": "",
      "UsernameSelectors": [
        "#UserName",
        "input[name='UserName']",
        "input[autocomplete='username']",
        "input[name*=user i]",
        "input[id*=user i]",
        "input[type=email]",
        "input[type=text]"
      ],
      "PasswordSelectors": [
        "#Password",
        "input[name='Password']",
        "input[autocomplete='current-password']",
        "input[type=password]"
      ],
      "SubmitSelectors": [
        "button[type=submit]:visible",
        "input[type=submit]:visible",
        "#btnSubmit",
        "button:has-text('Log in')",
        "button:has-text('Sign in')",
        "button:has-text('Submit')"
      ],
      "SuccessSelectors": [],
      "OutcomeTimeoutMs": 20000,
      "AllowUnverifiedLogin": false,
      "ErrorSelectors": [],
      "MfaSelectors": [],
      "ReadOnlyAllowedWritePaths": []
    },
    "Environments": {
      "KMSRC": {
        "DisplayName": "KMSRC",
        "ApplicationId": "KMS",
        "BaseUrl": "",
        "Type": "ReleaseCandidate",
        "Enabled": true,
        "Aliases": [
          "KMS RC",
          "KMS-RC"
        ],
        "AllowUserConfirmedStateChanges": false,
        "Login": {
          "SuccessSelectors": [],
          "ErrorSelectors": [],
          "MfaSelectors": [],
          "MaskSelectors": []
        }
      },
      "KMSQA": {
        "DisplayName": "KMSQA",
        "ApplicationId": "KMS",
        "BaseUrl": "",
        "Type": "QA",
        "Enabled": true,
        "Aliases": [
          "KMS QA",
          "KMS-QA"
        ],
        "AllowUserConfirmedStateChanges": false,
        "Login": {
          "SuccessSelectors": [],
          "ErrorSelectors": [],
          "MfaSelectors": [],
          "MaskSelectors": []
        }
      }
    }
  },
  "Agent": {
    "ActiveProviderId": "null",
    "DataDirectory": "App_Data",
    "EvidenceDirectory": "App_Data/evidence",
    "Browser": {
      "NavigationTimeoutMs": 120000,
      "ActionTimeoutMs": 45000,
      "SettleTimeoutMs": 45000,
      "PostActionDelayMs": 3000,
      "SpinnerTimeoutMs": 60000,
      "ProbeTimeoutMs": 2500,
      "Mode": "Deterministic",
      "Headless": true
    },
    "HistoricalJira": {
      "Enabled": true,
      "MaxCandidates": 15,
      "MaxRankedResults": 5,
      "MinStepAdoptionConfidence": 0.7,
      "MinSemanticScore": 0.55,
      "MinKeywordScore": 0.25
    },
    "KmsDocs": {
      "Enabled": true,
      "RootPath": "",
      "MaxChunks": 6,
      "ChunkSizeChars": 1200
    },
    "ValidationCommandAllowlist": [
      "dotnet build",
      "dotnet test"
    ],
    "Permissions": {
      "ReadJira": true,
      "UseBrowser": true,
      "ReadWorkspace": true,
      "ModifyCode": false,
      "RunValidation": false,
      "ManageCredentials": true,
      "ManageMemory": false,
      "GitCommit": false,
      "GitPush": false,
      "CreatePullRequest": false,
      "TriggerCi": false,
      "Deploy": false
    }
  },
  "Worker": {
    "MaxConcurrentJobs": 3,
    "JobTimeoutMinutes": 55,
    "AwaitingInputTimeoutMinutes": 30,
    "LeaseSeconds": 60,
    "PollIntervalMs": 1500,
    "MfaHoldMinutes": 5,
    "MaxJobLifetimeMinutes": 230
  },
  "Repositories": {
    "CheckoutRoot": "",
    "Mappings": [
      {
        "JiraProject": "VKMS",
        "Component": null,
        "ApplicationId": "KMS",
        "Provider": "AzureDevOps",
        "Organization": "",
        "Project": "",
        "Repository": "",
        "Branch": "main"
      }
    ]
  },
  "AzureDevOps": {
    "ManagedIdentityClientId": "",
    "CheckoutTimeoutSeconds": 300
  },
  "ReportPublishing": {
    "AttachScreenshots": true,
    "MaxAttachments": 8
  },
  "LlmProviders": {
    "OpenAiCompatible": {
      "BaseUrl": "https://api.openai.com/v1",
      "ApiKey": "",
      "Model": "gpt-4o-mini"
    },
    "Anthropic": {
      "BaseUrl": "https://api.anthropic.com",
      "ApiKey": "",
      "Model": "claude-3-5-sonnet-latest",
      "ApiVersion": "2023-06-01"
    },
    "AzureOpenAi": {
      "Endpoint": "",
      "ApiKey": "",
      "Deployment": "",
      "ApiVersion": "2024-08-01-preview"
    },
    "Cursor": {
      "ApiKey": "",
      "Model": ""
    }
  }
}