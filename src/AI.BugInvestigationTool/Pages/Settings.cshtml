@page
@model SettingsModel
@{ ViewData["Title"] = "Credentials & configuration"; }

<h1 class="h4">Credentials &amp; configuration</h1>
<p class="text-muted">Values are kept <strong>in server memory only</strong> for this session and are never written to disk, logs, URLs or reports.
    Secret fields are never sent back to the browser: leave one blank to keep the current value. Restarting the app clears them.</p>

<form method="post">
    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card"><div class="card-body">
                <h2 class="h6">Jira</h2>
                <label class="form-label small">Base URL</label>
                <input asp-for="Input.JiraBaseUrl" class="form-control mb-2" placeholder="https://your-site.atlassian.net" />
                <label class="form-label small">Email / username</label>
                <input asp-for="Input.JiraEmail" class="form-control mb-2" autocomplete="off" />
                <label class="form-label small">API token @Html.Raw(Model.Current.JiraApiToken is null ? "" : "<span class='badge text-bg-success'>set</span>")</label>
                <input asp-for="Input.JiraApiToken" type="password" value="" class="form-control" autocomplete="new-password" />
            </div></div>
        </div>
        <div class="col-lg-6">
            <div class="card"><div class="card-body">
                <h2 class="h6">Azure DevOps (read-only PAT: Code → Read)</h2>
                <label class="form-label small">Organization</label>
                <input asp-for="Input.AdoOrganization" class="form-control mb-2" placeholder="EHSQ" />
                <label class="form-label small">Project</label>
                <input asp-for="Input.AdoProject" class="form-control mb-2" placeholder="VisiumKMS" />
                <label class="form-label small">Personal access token @Html.Raw(Model.Current.AdoPat is null ? "" : "<span class='badge text-bg-success'>set</span>")</label>
                <input asp-for="Input.AdoPat" type="password" value="" class="form-control" autocomplete="new-password" />
            </div></div>
        </div>
        <div class="col-lg-6">
            <div class="card"><div class="card-body">
                <h2 class="h6">Claude API</h2>
                <label class="form-label small">API key @Html.Raw(Model.Current.ClaudeApiKey is null ? "" : "<span class='badge text-bg-success'>set</span>")</label>
                <input asp-for="Input.ClaudeApiKey" type="password" value="" class="form-control mb-2" autocomplete="new-password" />
                <div class="small text-muted">Model: <code>@Model.Model</code> (change <code>Tool:ClaudeModel</code> in appsettings).</div>
            </div></div>
        </div>
        <div class="col-lg-6">
            <div class="card"><div class="card-body">
                <h2 class="h6">Test environment</h2>
                <label class="form-label small">Environment URL</label>
                <input asp-for="Input.EnvironmentUrl" class="form-control mb-2" placeholder="https://qa.example.com" />
                <label class="form-label small">Allowed hosts (comma separated, <code>*.example.com</code> allowed)</label>
                <input asp-for="Input.AllowedHosts" class="form-control mb-2" placeholder="qa.example.com" />
                <div class="small text-muted mb-2">Configured in appsettings: @(Model.ConfiguredHosts.Count == 0 ? "none" : string.Join(", ", Model.ConfiguredHosts))</div>
                <label class="form-label small">Username</label>
                <input asp-for="Input.EnvironmentUsername" class="form-control mb-2" autocomplete="off" />
                <label class="form-label small">Password @Html.Raw(Model.Current.EnvironmentPassword is null ? "" : "<span class='badge text-bg-success'>set</span>")</label>
                <input asp-for="Input.EnvironmentPassword" type="password" value="" class="form-control" autocomplete="new-password" />
            </div></div>
        </div>
    </div>
    <div class="mt-3 d-flex gap-2">
        <button class="btn btn-primary" type="submit">Save in memory</button>
        <button class="btn btn-outline-danger" type="submit" asp-page-handler="Clear">Clear all</button>
    </div>
</form>
