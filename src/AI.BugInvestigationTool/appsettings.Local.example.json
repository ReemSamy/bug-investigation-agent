{
  "//": "Copy to appsettings.Local.json (git-ignored). Prefer `dotnet user-secrets` or environment variables for secrets.",
  "Tool": {
    "AllowedEnvironmentHosts": [ "qa.example.com", "*.staging.example.com" ],
    "LocalRepositoryPath": "D:/src/my-repo"
  },
  "Credentials": {
    "JiraBaseUrl": "https://your-site.atlassian.net",
    "JiraEmail": "you@example.com",
    "JiraApiToken": "<jira api token>",
    "AdoOrganization": "YourOrg",
    "AdoProject": "YourProject",
    "AdoPat": "<azure devops pat: Code (Read); Code (Read & write) only to post PR comments>",
    "ClaudeApiKey": "<anthropic api key>",
    "EnvironmentUrl": "https://qa.example.com",
    "EnvironmentUsername": "qa-user",
    "EnvironmentPassword": "<password>"
  }
}
