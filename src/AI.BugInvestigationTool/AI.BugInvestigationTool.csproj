<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AI.BugInvestigationTool</RootNamespace>
    <UserSecretsId>ai-bug-investigation-tool</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Browser investigation. 1.49.0 matches the locally installed Chromium build (chromium-1148). -->
    <PackageReference Include="Microsoft.Playwright" Version="1.49.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AI.BugInvestigationTool.Tests" />
  </ItemGroup>

</Project>
