@page "/credentials"
@rendermode InteractiveServer
@using BugInvestigationAgent.Core.Credentials
@using BugInvestigationAgent.Core.Environments
@inject ICredentialVault Vault
@inject IEnvironmentSelectionService EnvironmentSelection

<PageTitle>Credentials</PageTitle>

<section class="panel">
    <h2>Saved environment credentials</h2>
    <p class="muted">
        By default the agent asks for credentials in every investigation and does not store them.
        Profiles saved here (or with “Remember credentials securely”) are encrypted with ASP.NET Data Protection
        (key ring protected by Windows DPAPI), visible only to you, and used only for the environment they were saved for.
        Secrets are never sent to the LLM, logs, Jira or reports.
    </p>

    <h3>Add profile</h3>
    <div class="field">
        <label for="credEnv">Environment</label>
        <select id="credEnv" @bind="_environmentId">
            <option value="">— select environment —</option>
            @foreach (var env in EnvironmentSelection.Registry.List())
            {
                <option value="@env.Id" disabled="@(!env.Enabled)">@env.DisplayName (@env.Type)@(env.Enabled ? "" : " — disabled")</option>
            }
        </select>
    </div>
    <div class="field"><label for="credUser">Username</label><input id="credUser" @bind="_username" autocomplete="username" /></div>
    <div class="field"><label for="credRole">Role (optional)</label><input id="credRole" @bind="_role" /></div>
    <div class="field"><label for="credPassword">Password</label><input id="credPassword" type="password" @bind="_password" autocomplete="new-password" /></div>
    <div class="btn-row">
        <button class="btn" @onclick="SaveAsync">Save profile</button>
    </div>
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <p class="banner @(_messageIsError ? "warn" : "success")">@_message</p>
    }
</section>

<section class="panel">
    <h3>Your saved profiles</h3>
    @if (_profiles.Count == 0)
    {
        <p class="muted">No profiles yet.</p>
    }
    else
    {
        <table style="width:100%; border-collapse: collapse;">
            <thead>
            <tr>
                <th align="left">Label</th>
                <th align="left">Environment</th>
                <th align="left">User</th>
                <th align="left">Role</th>
                <th align="left">Updated</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var p in _profiles)
            {
                <tr>
                    <td>@p.Label</td>
                    <td>
                        @(p.EnvironmentId ?? p.EnvironmentName)
                        @if (p.IsLegacyUnscoped)
                        {
                            <div class="muted">Legacy profile (not tied to an environment) — never used automatically. Delete it and save it again for an environment.</div>
                        }
                    </td>
                    <td>@p.Username</td>
                    <td>@p.Role</td>
                    <td>@p.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    <td><button class="btn secondary" @onclick="() => DeleteAsync(p.Id)">Delete</button></td>
                </tr>
            }
            </tbody>
        </table>
    }
</section>

@code {
    private List<CredentialProfile> _profiles = new();
    private string _environmentId = "";
    private string _username = "";
    private string _role = "";
    private string _password = "";
    private string _message = "";
    private bool _messageIsError;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync() => _profiles = (await Vault.ListProfilesAsync()).ToList();

    private async Task SaveAsync()
    {
        _messageIsError = true;
        var env = string.IsNullOrWhiteSpace(_environmentId) ? null : EnvironmentSelection.Registry.Get(_environmentId);
        if (env is null)
        {
            _message = "Select the environment these credentials belong to.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_username) || string.IsNullOrEmpty(_password))
        {
            _message = "Username and password are required.";
            return;
        }

        try
        {
            var existing = await Vault.FindForEnvironmentAsync(env.Id, _username.Trim());
            await Vault.SaveProfileAsync(new CredentialProfile
            {
                Id = existing?.Id ?? Guid.NewGuid(),
                Label = $"{env.DisplayName} + {_username.Trim()}",
                SystemName = env.ApplicationId,
                EnvironmentName = env.DisplayName,
                EnvironmentId = env.Id,
                Username = _username.Trim(),
                Role = string.IsNullOrWhiteSpace(_role) ? null : _role.Trim()
            }, new CredentialSecret
            {
                Username = _username.Trim(),
                Password = _password
            });

            _messageIsError = false;
            _message = $"Saved encrypted credentials for {env.DisplayName}.";
        }
        finally
        {
            _password = "";
        }

        await ReloadAsync();
    }

    private async Task DeleteAsync(Guid id)
    {
        await Vault.DeleteProfileAsync(id);
        await ReloadAsync();
    }
}
