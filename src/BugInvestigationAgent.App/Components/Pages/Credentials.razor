@page "/credentials"
@rendermode InteractiveServer
@using BugInvestigationAgent.Core.Credentials
@inject ICredentialVault Vault

<PageTitle>Credentials</PageTitle>

<section class="panel">
    <h2>Credential profiles</h2>
    <p class="muted">Secrets are encrypted with ASP.NET Data Protection and never sent to the LLM, logs, or reports.</p>

    <h3>Add profile</h3>
    <div class="field"><label>Label</label><input @bind="_label" placeholder="System X + Coordinator" /></div>
    <div class="field"><label>System</label><input @bind="_system" /></div>
    <div class="field"><label>Environment</label><input @bind="_environment" /></div>
    <div class="field"><label>Username</label><input @bind="_username" autocomplete="username" /></div>
    <div class="field"><label>Role</label><input @bind="_role" /></div>
    <div class="field"><label>Password</label><input type="password" @bind="_password" autocomplete="new-password" /></div>
    <div class="field"><label>Token (optional)</label><input type="password" @bind="_token" /></div>
    <div class="btn-row">
        <button class="btn" @onclick="SaveAsync">Save profile</button>
    </div>
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <p class="banner success">@_message</p>
    }
</section>

<section class="panel">
    <h3>Saved profiles</h3>
    @if (_profiles.Count == 0)
    {
        <p class="muted">No profiles yet.</p>
    }
    else
    {
        <table style="width:100%; border-collapse: collapse;">
            <thead>
            <tr>
                <th align="left">Label</th>
                <th align="left">System</th>
                <th align="left">Env</th>
                <th align="left">User</th>
                <th align="left">Role</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var p in _profiles)
            {
                <tr>
                    <td>@p.Label</td>
                    <td>@p.SystemName</td>
                    <td>@p.EnvironmentName</td>
                    <td>@p.Username</td>
                    <td>@p.Role</td>
                    <td><button class="btn secondary" @onclick="() => DeleteAsync(p.Id)">Delete</button></td>
                </tr>
            }
            </tbody>
        </table>
    }
</section>

@code {
    private List<CredentialProfile> _profiles = new();
    private string _label = "";
    private string _system = "";
    private string _environment = "";
    private string _username = "";
    private string _role = "";
    private string _password = "";
    private string _token = "";
    private string _message = "";

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync() => _profiles = (await Vault.ListProfilesAsync()).ToList();

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_username))
        {
            _message = "Username is required.";
            return;
        }

        await Vault.SaveProfileAsync(new CredentialProfile
        {
            Label = string.IsNullOrWhiteSpace(_label) ? $"{_system} + {_username}" : _label,
            SystemName = NullIfEmpty(_system),
            EnvironmentName = NullIfEmpty(_environment),
            Username = _username,
            Role = NullIfEmpty(_role)
        }, new CredentialSecret
        {
            Username = _username,
            Password = _password,
            Token = NullIfEmpty(_token)
        });

        _password = "";
        _token = "";
        _message = "Profile saved. Secret stored encrypted.";
        await ReloadAsync();
    }

    private async Task DeleteAsync(Guid id)
    {
        await Vault.DeleteProfileAsync(id);
        await ReloadAsync();
    }

    private static string? NullIfEmpty(string value) => string.IsNullOrWhiteSpace(value) ? null : value;
}
