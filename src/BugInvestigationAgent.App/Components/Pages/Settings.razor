@page "/settings"
@rendermode InteractiveServer
@using BugInvestigationAgent.Core.Configuration
@using BugInvestigationAgent.Core.Orchestration
@using BugInvestigationAgent.Infrastructure.Settings
@using Microsoft.Extensions.Options
@inject LocalSettingsService LocalSettings
@inject IOptionsSnapshot<AgentOptions> AgentOptions
@inject IAgentRuntimeResolver RuntimeResolver
@inject JiraConnectionTester JiraTester
@inject IntegrationDiagnostics Diagnostics

<PageTitle>Sign in — Bug Investigation Agent</PageTitle>

<section class="panel">
    <h2>Sign in with your Atlassian account</h2>
    <p class="muted">
        The agent reads Jira <strong>as you</strong> (your permissions, your tickets).
        Atlassian does not allow apps to use your normal password — use your email + an
        <strong>API token</strong> created for your account. That is your account login for this tool.
    </p>

    @if (LocalSettings.IsSignedIn)
    {
        <div class="banner success">
            <strong>Signed in as @LocalSettings.SignedInDisplayName</strong>
            <div>@LocalSettings.SignedInEmail</div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="banner @(_messageOk ? "success" : "warn")">@_message</div>
    }

    @if (LocalSettings.UnreadableSecrets.Count > 0)
    {
        <div class="banner warn">Could not decrypt: @string.Join(", ", LocalSettings.UnreadableSecrets). Enter them again below
            (the encryption keys in App_Data/keys were replaced or this is another Windows account).</div>
    }
    <p class="muted">Secrets entered on this page are stored encrypted (Windows DPAPI-protected keys) in App_Data and are never shown again.</p>

    <h3>Your Atlassian account</h3>
    <div class="field">
        <label>Jira site</label>
        <input @bind="_jiraBaseUrl" placeholder="https://ehsq.atlassian.net" />
        <div class="muted" style="margin-top:0.35rem">Site root only (not a board link).</div>
    </div>
    <div class="field">
        <label>Your Atlassian email</label>
        <input @bind="_jiraEmail" placeholder="reem.mustafa@visiumkms.com" autocomplete="username" />
        <div class="muted" style="margin-top:0.35rem">Must be the same account you use in the browser to open tickets.</div>
    </div>
    <div class="field">
        <label>API token (acts as your password for the API) @(_jiraTokenSaved ? "(saved)" : "(not set)")</label>
        <input type="password" @bind="_jiraToken" placeholder="@(_jiraTokenSaved ? "•••••• saved — paste a new token to replace" : "Paste API token")" autocomplete="new-password" />
        <div class="muted" style="margin-top:0.35rem">
            1) Open <a href="https://id.atlassian.com/manage-profile/security/api-tokens" target="_blank" rel="noopener">id.atlassian.com → API tokens</a>
            while logged in as yourself<br />
            2) Create token → copy it → paste here<br />
            3) Click <strong>Sign in</strong>
        </div>
    </div>
    <div class="field">
        <label>Optional: verify with a ticket you can open</label>
        <input @bind="_sampleIssue" placeholder="VKMS-4180" />
    </div>

    <div class="btn-row">
        <button class="btn" @onclick="SignInAsync" disabled="@_busy">@(_busy ? "Signing in…" : "Sign in with my account")</button>
        @if (LocalSettings.IsSignedIn)
        {
            <button class="btn secondary" @onclick="SignOut">Sign out</button>
        }
        <a class="btn secondary" href="/">Back to Workflow</a>
    </div>

    <h3 style="margin-top:1.75rem">Default local workspace</h3>
    <div class="field">
        <label>Folder path on this PC</label>
        <input @bind="_workspace" placeholder="C:\Users\...\source\repos\kms-suite" />
    </div>
    <button class="btn secondary" @onclick="SaveWorkspaceOnly">Save workspace</button>

    <h3 style="margin-top:1.75rem">AI provider</h3>
    <p class="hint">Used for ticket understanding, similar-bug ranking and root-cause analysis. Choose
        <b>anthropic</b> or <b>openai-compatible</b> (cursor / azure-openai are not implemented). Saved keys are never shown
        again; leave a key empty to keep the saved one.</p>
    <div class="field">
        <label>Active provider</label>
        <select @bind="_providerId">
            @foreach (var id in RuntimeResolver.AvailableProviderIds)
            {
                <option value="@id">@id</option>
            }
        </select>
    </div>
    <div class="field">
        <label>Anthropic API key @(_anthropicKeySaved ? "(saved)" : "(not set)")</label>
        <input type="password" @bind="_anthropicKey" autocomplete="new-password" placeholder="@(_anthropicKeySaved ? "•••••• saved — type to replace" : "Paste API key")" />
    </div>
    <div class="field">
        <label>Anthropic model</label>
        <input @bind="_anthropicModel" placeholder="claude-opus-5-5" />
    </div>
    <div class="field">
        <label>OpenAI-compatible API key @(_openAiKeySaved ? "(saved)" : "(not set)")</label>
        <input type="password" @bind="_openAiKey" autocomplete="new-password" placeholder="@(_openAiKeySaved ? "•••••• saved — type to replace" : "Paste API key")" />
    </div>
    <div class="field">
        <label>OpenAI-compatible base URL</label>
        <input @bind="_openAiBaseUrl" placeholder="https://api.openai.com/v1" />
    </div>
    <div class="field">
        <label>OpenAI-compatible model</label>
        <input @bind="_openAiModel" />
    </div>
    <div class="field">
        <label>
            <input type="checkbox" @bind="_dataSharingApproved" />
            The company has approved sending Jira ticket content and source-code excerpts to the selected provider.
        </label>
        <div class="muted" style="margin-top:0.35rem">
            Until this is ticked, investigations run without the LLM and nothing is sent to it (the connection test below sends only a fixed "Reply with OK").
            @if (!string.IsNullOrWhiteSpace(_approvalNote)) { <span> @_approvalNote</span> }
        </div>
    </div>
    <div class="btn-row">
        <button class="btn secondary" @onclick="SaveAiOnly">Save AI settings</button>
        <button class="btn secondary" disabled="@_busy" @onclick="TestLlmAsync">@(_llmTesting ? "Testing… (up to a minute)" : "Test LLM connection")</button>
    </div>
    @if (!string.IsNullOrWhiteSpace(_llmTestResult))
    {
        <div class="banner @(_llmTestOk ? "success" : "warn")" style="margin-top:0.5rem">@_llmTestResult</div>
    }
    @if (!string.IsNullOrWhiteSpace(RuntimeResolver.LlmUnavailableReason))
    {
        <div class="banner warn" style="margin-top:0.5rem">Investigations currently run WITHOUT the LLM: @RuntimeResolver.LlmUnavailableReason</div>
    }

    <h3 style="margin-top:1.75rem">Integration check (read-only)</h3>
    <p class="muted">Checks the local source workspace (read-only Git commands), KMS documentation folder, environments, repository mapping and LLM settings. Nothing is changed.</p>
    <button class="btn secondary" disabled="@_busy" @onclick="CheckIntegrationsAsync">Check integrations</button>
    @if (_checks.Count > 0)
    {
        <table style="margin-top:0.5rem; border-collapse:collapse;">
            @foreach (var c in _checks)
            {
                <tr style="border-top:1px solid var(--border);">
                    <td style="padding-right:0.75rem">@(c.Ok ? "✅" : "⚠️") <b>@c.Area</b></td>
                    <td>@c.Detail</td>
                </tr>
            }
        </table>
    }
</section>

@code {
    private string _jiraBaseUrl = "https://ehsq.atlassian.net";
    private string _jiraEmail = "";
    private string _jiraToken = "";
    private string _workspace = "";
    private string _providerId = "null";
    private string _openAiKey = "";
    private string _anthropicKey = "";
    private bool _openAiKeySaved;
    private bool _anthropicKeySaved;
    private string _anthropicModel = "";
    private string _openAiModel = "";
    private string _openAiBaseUrl = "";
    private bool _jiraTokenSaved;
    private bool _dataSharingApproved;
    private string? _approvalNote;
    private IReadOnlyList<DiagnosticResult> _checks = Array.Empty<DiagnosticResult>();
    private string _message = "";
    private bool _messageOk;
    private bool _llmTesting, _llmTestOk;
    private string _llmTestResult = "";
    private bool _busy;
    private string _sampleIssue = "VKMS-4180";

    protected override void OnInitialized() => Load();

    private void Load()
    {
        var jira = LocalSettings.GetEffective();
        _jiraBaseUrl = string.IsNullOrWhiteSpace(jira.BaseUrl) ? "https://ehsq.atlassian.net" : jira.BaseUrl;
        _jiraEmail = jira.Email;
        _jiraToken = ""; // never sent back to the browser
        _jiraTokenSaved = !string.IsNullOrWhiteSpace(jira.ApiToken);
        var snapshot = LocalSettings.Snapshot;
        _dataSharingApproved = snapshot.LlmDataSharingApprovedAtUtc is not null;
        _approvalNote = snapshot.LlmDataSharingApprovedAtUtc is { } at
            ? $"Recorded by {snapshot.LlmDataSharingApprovedBy ?? "—"} on {at.LocalDateTime:yyyy-MM-dd HH:mm}."
            : null;
        _workspace = LocalSettings.DefaultWorkspacePath ?? "";
        _providerId = LocalSettings.GetActiveProviderId();
        var llm = LocalSettings.GetEffectiveLlm();
        // Never send saved API keys back to the browser: only whether one is saved.
        _openAiKey = "";
        _anthropicKey = "";
        _openAiKeySaved = !string.IsNullOrWhiteSpace(llm.OpenAiCompatible.ApiKey);
        _anthropicKeySaved = !string.IsNullOrWhiteSpace(llm.Anthropic.ApiKey);
        _anthropicModel = llm.Anthropic.Model;
        _openAiModel = llm.OpenAiCompatible.Model;
        _openAiBaseUrl = llm.OpenAiCompatible.BaseUrl;
    }

    private void PersistCredentials(bool clearSignedIn)
    {
        var doc = LocalSettings.Snapshot;
        doc.Jira.BaseUrl = JiraUrlNormalizer.NormalizeBaseUrl(_jiraBaseUrl);
        doc.Jira.Email = _jiraEmail.Trim();
        if (!string.IsNullOrWhiteSpace(_jiraToken))
            doc.Jira.ApiToken = _jiraToken.Trim();
        if (clearSignedIn)
        {
            doc.JiraSignedInDisplayName = null;
            doc.JiraSignedInEmail = null;
            doc.JiraSignedInAtUtc = null;
        }
        LocalSettings.Save(doc);
        _jiraBaseUrl = doc.Jira.BaseUrl;
    }

    private async Task SignInAsync()
    {
        _busy = true;
        _message = "";
        try
        {
            PersistCredentials(clearSignedIn: true);
            var result = await JiraTester.SignInAsync(_sampleIssue);
            _messageOk = result.Succeeded;
            _message = result.Message;
            Load();
        }
        catch (Exception ex)
        {
            _messageOk = false;
            _message = ex.Message;
            LocalSettings.ClearSignedInAccount();
        }
        finally
        {
            _busy = false;
        }
    }

    private void SignOut()
    {
        LocalSettings.ClearSignedInAccount();
        _messageOk = true;
        _message = "Signed out. Tickets will not load until you sign in again.";
    }

    private void SaveWorkspaceOnly()
    {
        var doc = LocalSettings.Snapshot;
        doc.DefaultWorkspacePath = string.IsNullOrWhiteSpace(_workspace) ? null : _workspace.Trim();
        LocalSettings.Save(doc);
        _messageOk = true;
        _message = "Workspace saved.";
    }

    private async Task TestLlmAsync()
    {
        _busy = true;
        try
        {
            (_llmTesting, _llmTestResult) = (true, "");
            StateHasChanged();
            var r = await Diagnostics.TestLlmAsync();
            (_llmTestOk, _llmTestResult) = (r.Ok, "LLM connection test: " + r.Detail);
        }
        catch (Exception ex)
        {
            (_llmTestOk, _llmTestResult) = (false, "LLM connection test failed: " + ex.Message);
        }
        finally
        {
            _busy = false;
            _llmTesting = false;
        }
    }

    private async Task CheckIntegrationsAsync()
    {
        _busy = true;
        try
        {
            _checks = await Diagnostics.CheckLocalAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private void SaveAiOnly()
    {
        var doc = LocalSettings.Snapshot;
        doc.ActiveProviderId = _providerId;
        if (!string.IsNullOrWhiteSpace(_openAiKey))
            doc.LlmProviders.OpenAiCompatible.ApiKey = _openAiKey.Trim();
        if (!string.IsNullOrWhiteSpace(_anthropicKey))
            doc.LlmProviders.Anthropic.ApiKey = _anthropicKey.Trim();
        if (!string.IsNullOrWhiteSpace(_anthropicModel))
            doc.LlmProviders.Anthropic.Model = _anthropicModel.Trim();
        if (!string.IsNullOrWhiteSpace(_openAiModel))
            doc.LlmProviders.OpenAiCompatible.Model = _openAiModel.Trim();
        if (!string.IsNullOrWhiteSpace(_openAiBaseUrl))
            doc.LlmProviders.OpenAiCompatible.BaseUrl = _openAiBaseUrl.Trim();
        if (_dataSharingApproved && doc.LlmDataSharingApprovedAtUtc is null)
        {
            doc.LlmDataSharingApprovedBy = LocalSettings.SignedInDisplayName ?? LocalSettings.SignedInEmail ?? Environment.UserName;
            doc.LlmDataSharingApprovedAtUtc = DateTimeOffset.UtcNow;
        }
        else if (!_dataSharingApproved)
        {
            doc.LlmDataSharingApprovedBy = null;
            doc.LlmDataSharingApprovedAtUtc = null;
        }
        LocalSettings.Save(doc);
        Load();
        _messageOk = true;
        _message = $"AI settings saved. Active provider: {_providerId} — used from the next investigation step.";
    }
}
