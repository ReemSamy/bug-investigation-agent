@inherits LayoutComponentBase

<div class="app-shell">
    <header class="app-header">
        <div class="brand">
            <span class="brand-mark" aria-hidden="true"></span>
            <div>
                <div class="brand-title">Bug Investigation Agent</div>
                <div class="brand-subtitle">Jira → Reproduce → Investigate → Fix → Validate</div>
            </div>
        </div>
        <nav class="app-nav">
            <NavLink href="/">Workflow</NavLink>
            <NavLink href="/investigations">Investigations</NavLink>
            <NavLink href="/batches">Batches</NavLink>
            <NavLink href="/reports">Reports</NavLink>
            <NavLink href="/settings">Sign in / Account</NavLink>
            <NavLink href="/credentials">Credentials</NavLink>
            <NavLink href="/memory">Memory</NavLink>
        </nav>
    </header>
    <main class="app-main">
        @Body
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
