{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Agent": {
    "ActiveProviderId": "null",
    "DataDirectory": "App_Data",
    "EvidenceDirectory": "App_Data/evidence",
    "Browser": {
      "NavigationTimeoutMs": 120000,
      "ActionTimeoutMs": 45000,
      "SettleTimeoutMs": 45000,
      "PostActionDelayMs": 3000,
      "SpinnerTimeoutMs": 60000,
      "ProbeTimeoutMs": 2500
    },
    "ValidationCommandAllowlist": [
      "dotnet build",
      "dotnet test"
    ],
    "Permissions": {
      "ReadJira": true,
      "UseBrowser": true,
      "ReadWorkspace": true,
      "ModifyCode": true,
      "RunValidation": true,
      "ManageCredentials": true,
      "ManageMemory": true,
      "GitCommit": false,
      "GitPush": false,
      "CreatePullRequest": false,
      "TriggerCi": false,
      "Deploy": false
    }
  },
  "Jira": {
    "BaseUrl": "",
    "Email": "",
    "ApiToken": ""
  },
  "LlmProviders": {
    "OpenAiCompatible": {
      "BaseUrl": "https://api.openai.com/v1",
      "ApiKey": "",
      "Model": "gpt-4o-mini"
    },
    "Anthropic": {
      "BaseUrl": "https://api.anthropic.com",
      "ApiKey": "",
      "Model": "claude-3-5-sonnet-latest",
      "ApiVersion": "2023-06-01"
    },
    "AzureOpenAi": {
      "Endpoint": "",
      "ApiKey": "",
      "Deployment": "",
      "ApiVersion": "2024-08-01-preview"
    },
    "Cursor": {
      "ApiKey": "",
      "Model": ""
    }
  }
}
