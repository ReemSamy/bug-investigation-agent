{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Agent": {
    "ActiveProviderId": "null",
    "DataDirectory": "App_Data",
    "EvidenceDirectory": "App_Data/evidence",
    "Browser": {
      "NavigationTimeoutMs": 120000,
      "ActionTimeoutMs": 45000,
      "SettleTimeoutMs": 45000,
      "PostActionDelayMs": 3000,
      "SpinnerTimeoutMs": 60000,
      "ProbeTimeoutMs": 2500,
      "Mode": "Deterministic",
      "Headless": true
    },
    "HistoricalJira": {
      "Enabled": true,
      "MaxCandidates": 15,
      "MaxRankedResults": 5,
      "MinStepAdoptionConfidence": 0.7,
      "MinSemanticScore": 0.55,
      "MinKeywordScore": 0.25
    },
    "KmsDocs": {
      "Enabled": true,
      "RootPath": "",
      "MaxChunks": 6,
      "ChunkSizeChars": 1200
    },
    "ValidationCommandAllowlist": [
      "dotnet build",
      "dotnet test"
    ],
    "Permissions": {
      "ReadJira": true,
      "UseBrowser": true,
      "ReadWorkspace": true,
      "ModifyCode": true,
      "RunValidation": true,
      "ManageCredentials": true,
      "ManageMemory": true,
      "GitCommit": false,
      "GitPush": false,
      "CreatePullRequest": false,
      "TriggerCi": false,
      "Deploy": false
    }
  },
  "EnvironmentRegistry": {
    "AllowAdHocUrl": true,
    "TreatAdHocAsProduction": false,
    "DefaultLogin": {
      "Mode": "Form",
      "LoginPath": "",
      "UsernameSelectors": [
        "#UserName",
        "input[name='UserName']",
        "input[autocomplete='username']",
        "input[name*=user i]",
        "input[id*=user i]",
        "input[type=email]",
        "input[type=text]"
      ],
      "PasswordSelectors": [
        "#Password",
        "input[name='Password']",
        "input[autocomplete='current-password']",
        "input[type=password]"
      ],
      "SubmitSelectors": [
        "button[type=submit]:visible",
        "input[type=submit]:visible",
        "#btnSubmit",
        "button:has-text('Log in')",
        "button:has-text('Sign in')",
        "button:has-text('Submit')"
      ],
      "SuccessSelectors": [],
      "OutcomeTimeoutMs": 20000,
      "AllowUnverifiedLogin": false,
      "ErrorSelectors": [],
      "MfaSelectors": [],
      "ReadOnlyAllowedWritePaths": []
    },
    "Environments": {
      "KMSRC": {
        "DisplayName": "KMSRC",
        "ApplicationId": "KMS",
        "BaseUrl": "",
        "Type": "ReleaseCandidate",
        "Enabled": true,
        "Aliases": [
          "KMS RC",
          "KMS-RC"
        ],
        "AllowUserConfirmedStateChanges": false,
        "Login": {
          "SuccessSelectors": [],
          "ErrorSelectors": [],
          "MfaSelectors": [],
          "MaskSelectors": []
        }
      },
      "KMSQA": {
        "DisplayName": "KMSQA",
        "ApplicationId": "KMS",
        "BaseUrl": "",
        "Type": "QA",
        "Enabled": true,
        "Aliases": [
          "KMS QA",
          "KMS-QA"
        ],
        "AllowUserConfirmedStateChanges": false,
        "Login": {
          "SuccessSelectors": [],
          "ErrorSelectors": [],
          "MfaSelectors": [],
          "MaskSelectors": []
        }
      }
    }
  },
  "Jira": {
    "BaseUrl": "",
    "Email": "",
    "ApiToken": ""
  },
  "LlmProviders": {
    "OpenAiCompatible": {
      "BaseUrl": "https://api.openai.com/v1",
      "ApiKey": "",
      "Model": "gpt-4o-mini"
    },
    "Anthropic": {
      "BaseUrl": "https://api.anthropic.com",
      "ApiKey": "",
      "Model": "claude-opus-5-5",
      "ApiVersion": "2023-06-01"
    },
    "AzureOpenAi": {
      "Endpoint": "",
      "ApiKey": "",
      "Deployment": "",
      "ApiVersion": "2024-08-01-preview"
    },
    "Cursor": {
      "ApiKey": "",
      "Model": ""
    }
  }
}